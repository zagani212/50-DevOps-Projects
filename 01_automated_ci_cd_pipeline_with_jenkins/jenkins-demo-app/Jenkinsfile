pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    stages {

        stage('Build') {
            steps {
                dir('01_automated_ci_cd_pipeline_with_jenkins/jenkins-demo-app') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('01_automated_ci_cd_pipeline_with_jenkins/jenkins-demo-app') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('01_automated_ci_cd_pipeline_with_jenkins/jenkins-demo-app') {
                    sh 'mvn package'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}