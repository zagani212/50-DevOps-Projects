/*
 * Nexus publish (often on another VM): set NEXUS_BASE_URL to http(s)://<nexus-vm-or-lb-host>:8081 reachable
 * from the Jenkins executor—localhost only works when Nexus listens on that same agent.
 * Jenkins credential kind "Username + password": NEXUS_CREDENTIALS_ID (default nexus-credentials).
 * Repos: maven-snapshots / maven-releases (hosted).
 *
 * Deploy to staging/prod: Ansible (ansible-playbook). Agent must have ansible-core installed.
 * Playbook: ansible/playbooks/deploy-jar.yml — same credentials as before (staging-vm-ip + staging-vm-ssh-key).
 */
pipeline {
    agent any

    parameters {
        string(
            name: 'SONARQUBE_INSTALLATION',
            defaultValue: 'SonarQube',
            trim: true,
            description: 'Exact Name of the SonarQube server entry in Jenkins global configuration.'
        )
        booleanParam(
            name: 'DEPLOY_TO_STAGING',
            defaultValue: false,
            description: 'Runs ansible/playbooks/deploy-jar.yml against staging (staging-vm-ip + staging-vm-ssh-key).'
        )
        booleanParam(
            name: 'DEPLOY_TO_PRODUCTION',
            defaultValue: false,
            description: 'Runs deploy playbook to production after approval (main/master); production-vm-ip + production-vm-ssh-key.'
        )
        string(
            name: 'NEXUS_BASE_URL',
            defaultValue: '',
            trim: true,
            description: 'Required unless set as job default: Nexus base URL, e.g. http://203.0.113.50:8081 — must be reachable from Jenkins agents when Nexus runs on another VM (not localhost in that layout). No trailing slash.'
        )
        string(
            name: 'NEXUS_CREDENTIALS_ID',
            defaultValue: 'nexus-credentials',
            trim: true,
            description: 'Jenkins "Username with password" credential ID for Nexus deploy.'
        )
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        APP_DIR = '01_automated_ci_cd_pipeline_with_jenkins/jenkins-demo-app'
        STAGING_REMOTE_JAR = '~/jenkins-demo-app.jar'
        PRODUCTION_REMOTE_JAR = '~/jenkins-demo-app.jar'
    }

    tools {
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B test'
                }
            }
        }

        stage('Code Analysis') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B compile test-compile checkstyle:check spotbugs:check'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${params.SONARQUBE_INSTALLATION}") {
                    dir(env.APP_DIR) {
                        sh 'mvn -B sonar:sonar'
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Artifact Publish') {
            steps {
                script {
                    def nexusBase = params.NEXUS_BASE_URL?.trim()
                    if (!nexusBase) {
                        error 'Set pipeline parameter NEXUS_BASE_URL to your Nexus VM (e.g. http://10.0.0.15:8081). Jenkins must reach Nexus on TCP 8081 from this agent—not localhost unless Nexus shares that host.'
                    }
                    nexusBase = nexusBase.replaceAll(/\/+$/, '')
                    withCredentials([usernamePassword(
                        credentialsId: params.NEXUS_CREDENTIALS_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )]) {
                        dir(env.APP_DIR) {
                            def snapshotsRepoUrl = "${nexusBase}/repository/maven-snapshots/"
                            def releasesRepoUrl = "${nexusBase}/repository/maven-releases/"
                            def settingsXml = """<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>nexus-snapshots</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-releases</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>"""
                            writeFile file: 'ci-settings.xml', encoding: 'UTF-8', text: settingsXml
                            sh """
                                mvn -B deploy -s ci-settings.xml \\
                                    '-Dnexus.snapshots.url=${snapshotsRepoUrl}' \\
                                    '-Dnexus.releases.url=${releasesRepoUrl}'
                            """
                            archiveArtifacts artifacts: 'target/*.jar',
                                excludes: '**/*-sources.jar',
                                fingerprint: true,
                                allowEmptyArchive: false
                        }
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                expression { return params.DEPLOY_TO_STAGING }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'staging-vm-ip', variable: 'STAGING_VM_IP'),
                    sshUserPrivateKey(
                        credentialsId: 'staging-vm-ssh-key',
                        keyFileVariable: 'STAGING_SSH_PRIVATE_KEY',
                        usernameVariable: 'STAGING_SSH_USER'
                    )
                ]) {
                    dir(env.APP_DIR) {
                        sh '''
                            set -eu
                            JAR=$(ls target/jenkins-demo-app-*.jar | head -1)
                            JAR_ABS="$(pwd)/$JAR"
                            JAR_NAME="$(basename "${STAGING_REMOTE_JAR}")"
                            export ANSIBLE_CONFIG="$(pwd)/ansible/ansible.cfg"
                            export ANSIBLE_HOST_KEY_CHECKING=False
                            export ANSIBLE_PRIVATE_KEY_FILE="${STAGING_SSH_PRIVATE_KEY}"
                            ansible-playbook ansible/playbooks/deploy-jar.yml \
                                -i "${STAGING_VM_IP}," \
                                -u "${STAGING_SSH_USER}" \
                                -e "deploy_jar_src=${JAR_ABS}" \
                                -e "deploy_jar_name=${JAR_NAME}"
                        '''
                    }
                }
            }
        }

        stage('Integration Test') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        echo "Running integration / API smoke tests against staging..."
                        echo "Example: mvn -B failsafe:integration-test failsafe:verify"
                    '''
                }
            }
        }

        stage('Deploy to Production') {
            when {
                allOf {
                    anyOf {
                        branch 'main'
                        branch 'master'
                    }
                    expression { return params.DEPLOY_TO_PRODUCTION }
                }
            }
            steps {
                input message: 'Approve production deployment?', ok: 'Deploy'
                withCredentials([
                    string(credentialsId: 'production-vm-ip', variable: 'PRODUCTION_VM_IP'),
                    sshUserPrivateKey(
                        credentialsId: 'production-vm-ssh-key',
                        keyFileVariable: 'PRODUCTION_SSH_PRIVATE_KEY',
                        usernameVariable: 'PRODUCTION_SSH_USER'
                    )
                ]) {
                    dir(env.APP_DIR) {
                        sh '''
                            set -eu
                            JAR=$(ls target/jenkins-demo-app-*.jar | head -1)
                            JAR_ABS="$(pwd)/$JAR"
                            JAR_NAME="$(basename "${PRODUCTION_REMOTE_JAR}")"
                            export ANSIBLE_CONFIG="$(pwd)/ansible/ansible.cfg"
                            export ANSIBLE_HOST_KEY_CHECKING=False
                            export ANSIBLE_PRIVATE_KEY_FILE="${PRODUCTION_SSH_PRIVATE_KEY}"
                            ansible-playbook ansible/playbooks/deploy-jar.yml \
                                -i "${PRODUCTION_VM_IP}," \
                                -u "${PRODUCTION_SSH_USER}" \
                                -e "deploy_jar_src=${JAR_ABS}" \
                                -e "deploy_jar_name=${JAR_NAME}"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh "rm -f \"${WORKSPACE}/${env.APP_DIR}/ci-settings.xml\" 2>/dev/null || true"
        }
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
