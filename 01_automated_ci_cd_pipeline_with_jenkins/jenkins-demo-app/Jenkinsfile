/* Where to configure what (three different places):
 *
 *   (1) JENKINS CONTROLLER — only in the Jenkins web UI (Manage Jenkins, job config, credentials):
 *       - Install plugins (e.g. SonarQube Scanner, Credentials Binding).
 *       - Configure System → SonarQube servers: friendly Name (matches SONARQUBE_INSTALLATION default
 *         "SonarQube"), Server URL = http(s)://<sonar-host>:9000, authentication = token from SonarQube.
 *       - Credentials: deploy VM host (Secret text ID) + SSH private key for staging/prod SCP.
 *       - Optional: SonarQube webhook → Jenkins URL (still created in SonarQube UI, but Jenkins must
 *         expose the URL SonarQube can reach).
 *
 *   (2) SONARQUBE HOST (its own machine/VM/container running SonarQube, not Jenkins and not app VMs):
 *       - Create projects / quality gates / rules, generate user tokens Jenkins will use.
 *       - Webhooks: point to Jenkins if you want instant quality-gate feedback (otherwise plugin polls).
 *
 *   (3) APP VMS (staging / production where the JAR is copied over SSH):
 *       - OS user, ~/.ssh/authorized_keys matching Jenkins’ key, writable deploy path, firewall for SSH.
 *
 *   This pipeline fails at waitForQualityGate if the SonarQube quality gate is not OK.
 */
pipeline {
    agent any

    parameters {
        string(
            name: 'SONARQUBE_INSTALLATION',
            defaultValue: 'SonarQube',
            trim: true,
            description: 'Exact Name of the SonarQube server entry in Jenkins global configuration.'
        )
        booleanParam(
            name: 'DEPLOY_TO_STAGING',
            defaultValue: false,
            description: 'Runs SCP to the staging VM using credentials staging-vm-ip + staging-vm-ssh-key.'
        )
        booleanParam(
            name: 'DEPLOY_TO_PRODUCTION',
            defaultValue: false,
            description: 'Runs production deploy after manual approval (main/master only); needs production-vm-ip + production-vm-ssh-key.'
        )
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        APP_DIR = '01_automated_ci_cd_pipeline_with_jenkins/jenkins-demo-app'
        STAGING_REMOTE_JAR = '~/jenkins-demo-app.jar'
        PRODUCTION_REMOTE_JAR = '~/jenkins-demo-app.jar'
    }

    tools {
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B test'
                }
            }
        }

        stage('Code Analysis') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B compile test-compile checkstyle:check spotbugs:check'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${params.SONARQUBE_INSTALLATION}") {
                    dir(env.APP_DIR) {
                        sh 'mvn -B sonar:sonar'
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Artifact Publish') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B deploy'
                    archiveArtifacts artifacts: 'target/*.jar,target/ci-staging-repo/**',
                        excludes: '**/*-sources.jar',
                        fingerprint: true,
                        allowEmptyArchive: false
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                expression { return params.DEPLOY_TO_STAGING }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'staging-vm-ip', variable: 'STAGING_VM_IP'),
                    sshUserPrivateKey(
                        credentialsId: 'staging-vm-ssh-key',
                        keyFileVariable: 'STAGING_SSH_PRIVATE_KEY',
                        usernameVariable: 'STAGING_SSH_USER'
                    )
                ]) {
                    dir(env.APP_DIR) {
                        sh '''
                            set -eu
                            JAR=$(ls target/jenkins-demo-app-*.jar | head -1)
                            scp -i "$STAGING_SSH_PRIVATE_KEY" -o BatchMode=yes \
                                -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
                                "$JAR" "${STAGING_SSH_USER}@${STAGING_VM_IP}:${STAGING_REMOTE_JAR}"
                        '''
                    }
                }
            }
        }

        stage('Integration Test') {
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        echo "Running integration / API smoke tests against staging..."
                        echo "Example: mvn -B failsafe:integration-test failsafe:verify"
                    '''
                }
            }
        }

        stage('Deploy to Production') {
            when {
                allOf {
                    anyOf {
                        branch 'main'
                        branch 'master'
                    }
                    expression { return params.DEPLOY_TO_PRODUCTION }
                }
            }
            steps {
                input message: 'Approve production deployment?', ok: 'Deploy'
                withCredentials([
                    string(credentialsId: 'production-vm-ip', variable: 'PRODUCTION_VM_IP'),
                    sshUserPrivateKey(
                        credentialsId: 'production-vm-ssh-key',
                        keyFileVariable: 'PRODUCTION_SSH_PRIVATE_KEY',
                        usernameVariable: 'PRODUCTION_SSH_USER'
                    )
                ]) {
                    dir(env.APP_DIR) {
                        sh '''
                            set -eu
                            JAR=$(ls target/jenkins-demo-app-*.jar | head -1)
                            scp -i "$PRODUCTION_SSH_PRIVATE_KEY" -o BatchMode=yes \
                                -o IdentitiesOnly=yes -o StrictHostKeyChecking=no \
                                "$JAR" "${PRODUCTION_SSH_USER}@${PRODUCTION_VM_IP}:${PRODUCTION_REMOTE_JAR}"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
