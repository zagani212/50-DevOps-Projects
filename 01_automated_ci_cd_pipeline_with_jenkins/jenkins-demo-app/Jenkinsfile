import groovy.json.JsonOutput

/** String params from Jenkins may be String or hudson.util.Secret — never call .trim() on the raw param. */
String paramToStringTrim(def p) {
    if (p == null) {
        return ''
    }
    if (p instanceof CharSequence) {
        return p.toString().trim()
    }
    try {
        return p.getPlainText().toString().trim()
    } catch (Throwable ignored) {
        return p.toString().trim()
    }
}

/* Post JSON to Slack Incoming Webhook (Secret text credential = full https://hooks.slack.com/... URL).
 * Leave credId empty to skip. Optional channel overrides webhook default (#channel or @user). */
void sendSlack(def credIdRaw, def channelOverrideRaw, Map slackPayload) {
    def credId = paramToStringTrim(credIdRaw)
    if (!credId) {
        return
    }
    def channelOverride = paramToStringTrim(channelOverrideRaw)
    if (channelOverride) {
        slackPayload.channel = channelOverride
    }
    def body = JsonOutput.toJson(slackPayload)
    def payloadFile = ".slack-payload-${env.BUILD_TAG}.json"
    writeFile file: payloadFile, text: body, encoding: 'UTF-8'
    try {
        withCredentials([string(credentialsId: credId, variable: 'SLACK_WEBHOOK_URL')]) {
            if (isUnix()) {
                sh """
                    set +x
                    curl -sS -X POST -H 'Content-Type: application/json' \\
                      --data @${payloadFile} "\$SLACK_WEBHOOK_URL" || true
                """
            } else {
                bat """
                    curl -sS -X POST -H "Content-Type: application/json" ^
                      --data @${payloadFile} %SLACK_WEBHOOK_URL%
                """
            }
        }
    } catch (ignored) {
        echo 'Slack notification skipped (credential missing or curl failed).'
    } finally {
        if (isUnix()) {
            sh "rm -f '${payloadFile}' 2>/dev/null || true"
        } else {
            bat "if exist \"${payloadFile}\" del /f /q \"${payloadFile}\""
        }
    }
}

void sendSlackText(def credId, def channelOverride, String text, String attachmentColor) {
    if (attachmentColor) {
        sendSlack(credId, channelOverride, [
            attachments: [[
                color: attachmentColor,
                text : text,
                mrkdwn_in: ['text']
            ]]
        ])
    } else {
        sendSlack(credId, channelOverride, [text: text])
    }
}

String slackJobSummary() {
    def br = env.BRANCH_NAME ?: env.GIT_BRANCH ?: '(unknown)'
    return "*${env.JOB_NAME}* #${env.BUILD_NUMBER} — branch `${br}`\n${env.RUN_DISPLAY_URL}"
}

/** true when this build targets main/master (merged release line)—production deploy runs here only. */
boolean isReleaseProdBranch() {
    def br = paramToStringTrim(env.BRANCH_NAME)
    if (br in ['main', 'master']) {
        return true
    }
    def gitBr = paramToStringTrim(env.GIT_BRANCH)
    return gitBr in ['origin/main', 'origin/master', 'refs/heads/main', 'refs/heads/master']
}

/*
 * Nexus publish (often on another VM): set NEXUS_BASE_URL to http(s)://<nexus-vm-or-lb-host>:8081 reachable
 * from the Jenkins executor—localhost only works when Nexus listens on that same agent.
 * Jenkins credential kind "Username + password": NEXUS_CREDENTIALS_ID (default nexus-credentials).
 * Repos: maven-snapshots / maven-releases (hosted).
 *
 * Deploy to staging/prod: Ansible (ansible-playbook). Agent must have ansible-core installed.
 * Flow: Feature branches → full CI through staging + integration (no prod). main/master after merge →
 * same CI but skips staging/integration, then manual approval + production Ansible (uses fresh build on main).
 *
 * Slack: Incoming Webhook via SLACK_WEBHOOK_CREDENTIAL_ID (Secret text Jenkins credential whose value is URL).
 */
pipeline {
    agent any

    parameters {
        string(
            name: 'SONARQUBE_INSTALLATION',
            defaultValue: 'SonarQube',
            trim: true,
            description: 'Exact Name of the SonarQube server entry in Jenkins global configuration.'
        )
        string(
            name: 'NEXUS_BASE_URL',
            defaultValue: '',
            trim: true,
            description: 'Required unless set as job default: Nexus base URL, e.g. http://203.0.113.50:8081 — must be reachable from Jenkins agents when Nexus runs on another VM (not localhost in that layout). No trailing slash.'
        )
        string(
            name: 'NEXUS_CREDENTIALS_ID',
            defaultValue: 'nexus-credentials',
            trim: true,
            description: 'Jenkins "Username with password" credential ID for Nexus deploy.'
        )
        string(
            name: 'SLACK_WEBHOOK_CREDENTIAL_ID',
            defaultValue: 'slack-incoming-webhook',
            trim: true,
            description: 'Secret text credential ID whose value is the full Slack Incoming Webhook URL; leave empty to disable Slack.'
        )
        string(
            name: 'SLACK_CHANNEL',
            defaultValue: '#tous-abdelhak',
            trim: true,
            description: 'Optional Slack channel (#builds) or @user id to override the webhook default.'
        )
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        APP_DIR = '01_automated_ci_cd_pipeline_with_jenkins/jenkins-demo-app'
        STAGING_REMOTE_JAR = '~/jenkins-demo-app.jar'
        PRODUCTION_REMOTE_JAR = '~/jenkins-demo-app.jar'
    }

    tools {
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B test'
                }
            }
        }

        stage('Code Analysis') {
            steps {
                dir(env.APP_DIR) {
                    sh 'mvn -B compile test-compile checkstyle:check spotbugs:check'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv(paramToStringTrim(params.SONARQUBE_INSTALLATION)) {
                    dir(env.APP_DIR) {
                        sh 'mvn -B sonar:sonar'
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Artifact Publish') {
            steps {
                script {
                    def nexusBase = paramToStringTrim(params.NEXUS_BASE_URL)
                    if (!nexusBase) {
                        error 'Set pipeline parameter NEXUS_BASE_URL to your Nexus VM (e.g. http://10.0.0.15:8081). Jenkins must reach Nexus on TCP 8081 from this agent—not localhost unless Nexus shares that host.'
                    }
                    nexusBase = nexusBase.replaceAll(/\/+$/, '')
                    withCredentials([usernamePassword(
                        credentialsId: paramToStringTrim(params.NEXUS_CREDENTIALS_ID),
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )]) {
                        dir(env.APP_DIR) {
                            def snapshotsRepoUrl = "${nexusBase}/repository/maven-snapshots/"
                            def releasesRepoUrl = "${nexusBase}/repository/maven-releases/"
                            def settingsXml = """<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>nexus-snapshots</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>nexus-releases</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>"""
                            writeFile file: 'ci-settings.xml', encoding: 'UTF-8', text: settingsXml
                            sh """
                                mvn -B deploy -s ci-settings.xml \\
                                    '-Dnexus.snapshots.url=${snapshotsRepoUrl}' \\
                                    '-Dnexus.releases.url=${releasesRepoUrl}'
                            """
                            archiveArtifacts artifacts: 'target/*.jar',
                                excludes: '**/*-sources.jar',
                                fingerprint: true,
                                allowEmptyArchive: false
                        }
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                expression { return !isReleaseProdBranch() }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'staging-vm-ip', variable: 'STAGING_VM_IP'),
                    sshUserPrivateKey(
                        credentialsId: 'staging-vm-ssh-key',
                        keyFileVariable: 'STAGING_SSH_PRIVATE_KEY',
                        usernameVariable: 'STAGING_SSH_USER'
                    )
                ]) {
                    dir(env.APP_DIR) {
                        sh '''
                            set -eu
                            JAR=$(ls target/jenkins-demo-app-*.jar | head -1)
                            JAR_ABS="$(pwd)/$JAR"
                            JAR_NAME="$(basename "${STAGING_REMOTE_JAR}")"
                            export ANSIBLE_CONFIG="$(pwd)/ansible/ansible.cfg"
                            export ANSIBLE_HOST_KEY_CHECKING=False
                            export ANSIBLE_PRIVATE_KEY_FILE="${STAGING_SSH_PRIVATE_KEY}"
                            ansible-playbook ansible/playbooks/deploy-jar.yml \
                                -i "${STAGING_VM_IP}," \
                                -u "${STAGING_SSH_USER}" \
                                -e "deploy_jar_src=${JAR_ABS}" \
                                -e "deploy_jar_name=${JAR_NAME}"
                        '''
                    }
                }
            }
        }

        stage('Integration Test') {
            when {
                expression { return !isReleaseProdBranch() }
            }
            steps {
                dir(env.APP_DIR) {
                    sh '''
                        echo "Running integration / API smoke tests against staging..."
                        echo "Example: mvn -B failsafe:integration-test failsafe:verify"
                    '''
                }
            }
        }

        stage('Production approval (manual)') {
            when {
                expression { return isReleaseProdBranch() }
            }
            steps {
                script {
                    def cred = paramToStringTrim(params.SLACK_WEBHOOK_CREDENTIAL_ID)
                    def ch = paramToStringTrim(params.SLACK_CHANNEL)
                    def msg = ":hourglass_flowing_sand: *Awaiting manual production approval*\n${slackJobSummary()}\nOpen the build in Jenkins and approve *Production approval* to continue."
                    sendSlackText(cred, ch, msg, 'warning')
                }
                timeout(time: 24, unit: 'HOURS') {
                    input(
                        id: 'production-deploy-approval',
                        message: 'Manual approval — production deploy on main/master.\n' +
                            'Merge to main should occur only after a green CI run on your feature branch. Approve to run Ansible.',
                        ok: 'Approve and deploy to production',
                        submitterParameter: 'PROD_DEPLOY_APPROVER'
                    )
                }
            }
        }

        stage('Deploy to Production') {
            when {
                expression { return isReleaseProdBranch() }
            }
            steps {
                script {
                    def who = env.PROD_DEPLOY_APPROVER ?: '(unknown)'
                    echo "Production deploy approved by: ${who}"
                }
                withCredentials([
                    string(credentialsId: 'production-vm-ip', variable: 'PRODUCTION_VM_IP'),
                    sshUserPrivateKey(
                        credentialsId: 'production-vm-ssh-key',
                        keyFileVariable: 'PRODUCTION_SSH_PRIVATE_KEY',
                        usernameVariable: 'PRODUCTION_SSH_USER'
                    )
                ]) {
                    dir(env.APP_DIR) {
                        sh '''
                            set -eu
                            JAR=$(ls target/jenkins-demo-app-*.jar | head -1)
                            JAR_ABS="$(pwd)/$JAR"
                            JAR_NAME="$(basename "${PRODUCTION_REMOTE_JAR}")"
                            export ANSIBLE_CONFIG="$(pwd)/ansible/ansible.cfg"
                            export ANSIBLE_HOST_KEY_CHECKING=False
                            export ANSIBLE_PRIVATE_KEY_FILE="${PRODUCTION_SSH_PRIVATE_KEY}"
                            ansible-playbook ansible/playbooks/deploy-jar.yml \
                                -i "${PRODUCTION_VM_IP}," \
                                -u "${PRODUCTION_SSH_USER}" \
                                -e "deploy_jar_src=${JAR_ABS}" \
                                -e "deploy_jar_name=${JAR_NAME}"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh "rm -f \"${WORKSPACE}/${env.APP_DIR}/ci-settings.xml\" 2>/dev/null || true"
        }
        success {
            script {
                def cred = paramToStringTrim(params.SLACK_WEBHOOK_CREDENTIAL_ID)
                def ch = paramToStringTrim(params.SLACK_CHANNEL)
                def msg = ":white_check_mark: *Pipeline SUCCESS*\n${slackJobSummary()}"
                sendSlackText(cred, ch, msg, 'good')
            }
            echo 'Pipeline completed successfully.'
        }
        failure {
            script {
                def cred = paramToStringTrim(params.SLACK_WEBHOOK_CREDENTIAL_ID)
                def ch = paramToStringTrim(params.SLACK_CHANNEL)
                def msg = ":x: *Pipeline FAILURE*\n${slackJobSummary()}"
                sendSlackText(cred, ch, msg, 'danger')
            }
            echo 'Pipeline failed.'
        }
        aborted {
            script {
                def cred = paramToStringTrim(params.SLACK_WEBHOOK_CREDENTIAL_ID)
                def ch = paramToStringTrim(params.SLACK_CHANNEL)
                def msg = ":black_square_for_stop: *Pipeline ABORTED* (e.g. input declined or stopped)\n${slackJobSummary()}"
                sendSlackText(cred, ch, msg, '#9E9E9E')
            }
        }
        unstable {
            script {
                def cred = paramToStringTrim(params.SLACK_WEBHOOK_CREDENTIAL_ID)
                def ch = paramToStringTrim(params.SLACK_CHANNEL)
                def msg = ":warning: *Pipeline UNSTABLE*\n${slackJobSummary()}"
                sendSlackText(cred, ch, msg, 'warning')
            }
        }
    }
}
